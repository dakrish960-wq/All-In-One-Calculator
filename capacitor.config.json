{
  "appId": "com.calculator.allinone",
  "appName": "All In One Calculator",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "automatic"
  },
  "android": {
    "buildOptions": {
      "releaseType": "AAB"
    }
  },
  "plugins": {
